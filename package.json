{
  "name": "animated-shorts-dev",
  "private": true,
  "scripts": {
    "studio": "remotion studio src/index.tsx",
    "typecheck": "tsc --noEmit",
    "render:smoke": "remotion render src/index.tsx PocketEclipse out/pocket-eclipse.mp4 --codec=h264 --gl=swangle --concurrency=2",
    "render:kite": "remotion render src/index.tsx LayangLayangPulang out/kite/picture.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p --gl=swangle --concurrency=2 --timeout=120000"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "@react-three/postprocessing": "3.2.2",
    "@remotion/cli": "4.0.545",
    "@remotion/three": "4.0.545",
    "postprocessing": "6.39.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.545",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/three": "0.187.0",
    "typescript": "5.9.3"
  }
}
